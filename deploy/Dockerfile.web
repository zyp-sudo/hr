# =============================================================================
# TalentMatch Web Frontend — Competition Image
# Port: 3000  |  Express + Vite SPA (production mode)
# Build context: talentmatch/
# =============================================================================

# ---- build stage ------------------------------------------------------------
FROM node:22-slim AS build

WORKDIR /build

# Install all dependencies (including devDependencies for vite/esbuild/typescript)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source and config files
COPY tsconfig.json vite.config.ts index.html ./
COPY server.ts ./
COPY src/ ./src/
COPY assets/ ./assets/

# Build: vite produces dist/ (SPA), esbuild bundles server.ts → dist/server.cjs
RUN npm run build

# ---- run stage --------------------------------------------------------------
FROM node:22-slim

LABEL org.xh202621.service="web-frontend"
LABEL org.xh202621.port="3000"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r xh && useradd -r -g xh -d /app xh

WORKDIR /app

# Production dependencies only
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Built artifacts from build stage
COPY --from=build /build/dist/ ./dist/

# Non-root user
RUN chown -R xh:xh /app
USER xh

# ---- health check -----------------------------------------------------------
HEALTHCHECK --interval=15s --timeout=5s --retries=3 --start-period=10s \
    CMD curl -fsS http://localhost:3000/api/health || exit 1

# ---- run --------------------------------------------------------------------
EXPOSE 3000
ENV NODE_ENV=production
CMD ["node", "dist/server.cjs"]
