# =============================================================================
# XH-202621 TalentMatch — Competition Environment Variables
#
# Copy this file to deploy/.env and fill in values before starting:
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.competition.yml up -d
# =============================================================================

# ---- MySQL ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=job_kg
MYSQL_PORT=3307
MYSQL_CONTAINER_NAME=xh-comp-mysql

# ---- Neo4j ---------------------------------------------------------------
NEO4J_PASSWORD=password123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_CONTAINER_NAME=xh-comp-neo4j

# ---- Elasticsearch -------------------------------------------------------
ES_PORT=9200
ES_CONTAINER_NAME=xh-comp-elasticsearch

# ---- Milvus --------------------------------------------------------------
MILVUS_PORT=19530
MILVUS_WEBUI_PORT=9091
MILVUS_ETCD_CONTAINER_NAME=xh-comp-milvus-etcd
MILVUS_MINIO_CONTAINER_NAME=xh-comp-milvus-minio
MILVUS_CONTAINER_NAME=xh-comp-milvus
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MILVUS_TOKEN=

# ---- Application ports ---------------------------------------------------
STORAGE_API_PORT=8080
JAVA_API_PORT=8081
WEB_PORT=3000

# ---- AI / LLM (optional — leave empty for rule-based fallback) -----------
GEMINI_API_KEY=
AI_PROVIDER=google
GEMINI_MODEL=gemini-2.5-flash
AI_BASE_URL=

# ---- Company Agent (external intelligent scoring adapter) -----------------
# Set ENABLED=true and fill BASE_URL + API_KEY when your company provides
# the agent endpoint.  Leave disabled otherwise — local scoring still works.
COMPANY_AGENT_ENABLED=false
COMPANY_AGENT_BASE_URL=
COMPANY_AGENT_API_KEY=
COMPANY_AGENT_TIMEOUT_SECONDS=30
COMPANY_AGENT_MAX_RETRIES=1
